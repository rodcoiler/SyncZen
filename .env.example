# Configuración de Shopify (Alere Gourmet)
SHOPIFY_SHOP_DOMAIN=alere-gourmet.myshopify.com

# Credenciales de Shopify (OAuth Client Credentials)
SHOPIFY_CLIENT_ID=tu_client_id_aqui
SHOPIFY_CLIENT_SECRET=tu_client_secret_aqui

# (Opcional) Si usas token directo fijo
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-01

# Configuración de WooCommerce / WordPress
WOO_STORE_URL=https://aleregourmet.com.br
WOO_CONSUMER_KEY=ck_tu_consumer_key_aqui
WOO_CONSUMER_SECRET=cs_tu_consumer_secret_aqui

# Token Secreto del Plugin Derene Sync Woo (Opcional si usas REST directo)
DERENE_PLUGIN_SECRET=

# Servidor y Frecuencia de Sincronización Automática
PORT=3001
CRON_SCHEDULE=0 */2 * * *
